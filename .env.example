# Spring Boot 后端会读取的环境变量
# 覆盖 application.yml 里的同名属性
# 完整列表见 Spring Boot 文档：https://docs.spring.io/spring-boot/reference/features/external-config.html

# ===== 数据库 =====
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/school_salary?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ===== JWT =====
JWT_SECRET=school-salary-admin-system-internal-use-only-2026
JWT_EXPIRE_HOURS=72

# ===== 文件 =====
APP_UPLOAD_DIR=./uploads

# ===== 应用 =====
SERVER_PORT=8080
